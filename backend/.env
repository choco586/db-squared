# ─── Primary DB — AWS RDS ──────────────────────────────────────────────────────
PRIMARY_HOST=primary-db.c5aa0ok2c9a4.eu-north-1.rds.amazonaws.com
PRIMARY_PORT=3306
PRIMARY_USER=admin
PRIMARY_PASSWORD=your_rds_password_here
PRIMARY_DB=testdb

# ─── Secondary DB — Docker MySQL ───────────────────────────────────────────────
SECONDARY_HOST=192.168.1.108
SECONDARY_PORT=3307
SECONDARY_USER=root
SECONDARY_PASSWORD=your_docker_mysql_password_here
SECONDARY_DB=testdb

# ─── Replication ────────────────────────────────────────────────────────────────
PRIMARY_REPLICATION_HOST=192.168.1.108
REPLICA_USER=replica_user
REPLICA_PASSWORD=replica_user123

# ─── AWS S3 — backup storage ────────────────────────────────────────────────────
AWS_REGION=eu-north-1
AWS_BACKUP_BUCKET=db-squared-backups